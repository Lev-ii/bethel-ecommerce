# ----------------------------------------------------------------- Base
# Supabase : Project Settings > Database.
# DATABASE_URL  = connexion "Transaction pooler" (port 6543), utilisee par l'app
# DIRECT_URL    = connexion "Direct" (port 5432), utilisee par les migrations
DATABASE_URL="postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------- Sessions
# Au moins 16 caracteres, tires au hasard :  openssl rand -base64 32
# Obligatoire avant toute mise en ligne : sans lui, un secret de
# demonstration connu est utilise.
AUTH_SECRET=""

# -------------------------------------------------------------- Photos
# Supabase : Project Settings > API.
# La cle service_role ne doit JAMAIS apparaitre cote navigateur.
# Sans ces trois variables, les photos sont ecrites sur le disque local :
# pratique en developpement, inutilisable sur Vercel.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="produits"

# ------------------------------------------------- Suivi publicitaire
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
