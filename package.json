{
  "name": "bethel",
  "version": "3.3.0",
  "private": true,
  "description": "Bethel — boutique en ligne de materiel pour createurs de contenu",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-preview.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "VITEST_DB=1 vitest run",
    "test:integration": "python3 tests/integration.py",
    "test:e2e": "playwright test",
    "test:charge": "DATABASE_URL=${CHARGE_DATABASE_URL:-postgresql://localhost:5432/bethel_charge} node tests/e2e/preparer-base.mjs && DATABASE_URL=${CHARGE_DATABASE_URL:-postgresql://localhost:5432/bethel_charge} VITEST_CHARGE=1 vitest run",
    "test:volume": "node tests/volume/preparer.mjs && DATABASE_URL=${VOLUME_DATABASE_URL:-postgresql://localhost:5432/bethel_volume} VITEST_VOLUME=1 vitest run",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:status": "node --env-file-if-exists=.env scripts/migrate.mjs --status",
    "db:migrate:prod:status": "node --env-file=.env.prod-db.local scripts/migrate.mjs --status",
    "db:migrate:prod": "node --env-file=.env.prod-db.local scripts/migrate.mjs",
    "test:concurrence": "node --env-file-if-exists=.env tests/concurrence.mjs",
    "admin:role": "node --env-file-if-exists=.env scripts/set-role.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
